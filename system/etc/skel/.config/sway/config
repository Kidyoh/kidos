# KidOS — Sway config. Keyboard-first, Omarchy-style bindings, tuned for old PCs.

set $mod   Mod4
set $term  foot
set $menu  fuzzel
set $left  h
set $down  j
set $up    k
set $right l

# ---- palette (KidOS night)
set $bg     #14161b
set $fg     #d8dee9
set $accent #7aa2f7
set $muted  #3b4252
set $urgent #f7768e

# ---- look (solid colour wallpaper: zero image memory)
output * bg $bg solid_color
font pango:JetBrains Mono 10
default_border pixel 2
default_floating_border pixel 2
gaps inner 4
smart_gaps on
hide_edge_borders --i3 smart
#                       border  bg      text  indicator child_border
client.focused          $accent $accent $bg   $accent   $accent
client.unfocused        $muted  $bg     $fg   $muted    $muted
client.focused_inactive $muted  $bg     $fg   $muted    $muted
client.urgent           $urgent $urgent $bg   $urgent   $urgent

# ---- lean: no X11 compatibility layer unless you need it (saves ~40MB)
xwayland disable

# ---- input
input type:keyboard xkb_options caps:escape
input type:touchpad {
    tap enabled
    natural_scroll enabled
}

# ---- apps
bindsym $mod+Return exec $term
bindsym $mod+Space  exec $menu
bindsym $mod+w      kill
bindsym $mod+f      fullscreen toggle
bindsym $mod+t      floating toggle
bindsym $mod+Escape exec swaylock -f -c 14161b
bindsym $mod+Shift+s exec grim -g "$(slurp)" - | wl-copy
bindsym Print        exec grim ~/screenshot-$(date +%s).png
bindsym $mod+Shift+r reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Leave KidOS?' -B 'Log out' 'swaymsg exit'

# KidOS: open machine history in a terminal
bindsym $mod+g exec $term -e sh -c 'kidos log -n 40; read -r _'

# ---- focus / move
bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right
bindsym $mod+Left   focus left
bindsym $mod+Down   focus down
bindsym $mod+Up     focus up
bindsym $mod+Right  focus right
bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right

# ---- layout
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+e layout toggle split
bindsym $mod+s layout stacking
floating_modifier $mod normal

mode "resize" {
    bindsym $left  resize shrink width 20px
    bindsym $down  resize grow height 20px
    bindsym $up    resize shrink height 20px
    bindsym $right resize grow width 20px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# ---- workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

# ---- media keys
bindsym XF86AudioRaiseVolume  exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume  exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute         exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86MonBrightnessUp   exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# ---- bar: built-in swaybar + a tiny shell status (no waybar = less RAM)
bar {
    position top
    status_command kidos-status
    font pango:JetBrains Mono 9
    colors {
        background $bg
        statusline $fg
        focused_workspace  $accent $accent $bg
        inactive_workspace $bg     $bg     $fg
        urgent_workspace   $urgent $urgent $bg
    }
}

# ---- background services
exec mako
exec swayidle -w \
    timeout 600 'swaylock -f -c 14161b' \
    timeout 900 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f -c 14161b'

include /etc/sway/config.d/*
