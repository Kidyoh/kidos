#!/usr/bin/env bash
# kidos — git-style version control for the whole machine.
#
# The root filesystem is the "repo", btrfs snapshots are the "commits",
# snapper does the bookkeeping. Every pacman transaction auto-commits (snap-pac).
set -euo pipefail

VERSION=0.2.0
CFG=root
SNAPDIR=/.snapshots

if [[ -t 1 ]]; then
  B=$'\e[1m' D=$'\e[2m' R=$'\e[31m' G=$'\e[32m' Y=$'\e[33m' C=$'\e[36m' N=$'\e[0m'
else
  B='' D='' R='' G='' Y='' C='' N=''
fi
die()  { printf '%skidos:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
snap() { snapper --no-dbus -c "$CFG" "$@"; }
confirm() { [[ -n ${KIDOS_YES:-} ]] && return; local a; read -rp "$1 [y/N] " a; [[ $a == [yY]* ]] || die "aborted"; }

usage() {
  cat <<EOF
${B}kidos${N} $VERSION — version control for your whole OS

  ${B}kidos status${N}                  what changed since the last snapshot
  ${B}kidos commit -m "msg"${N}         snapshot the system now
  ${B}kidos log${N} [-n N] [--json]     history (commits + automatic pacman snapshots)
  ${B}kidos show${N} REF                one snapshot: details + packages it changed
  ${B}kidos diff${N} [A] [B] [--pkgs]   compare two points (default: HEAD vs current)
  ${B}kidos tag${N} REF NAME            name a snapshot, e.g. kidos tag 12 stable
  ${B}kidos restore${N} REF PATH...     bring files back as they were at REF
  ${B}kidos rollback${N} REF            make the whole OS = REF (reboot to apply)
  ${B}kidos gc${N}                      clean old snapshots and pre-rollback leftovers

  ${B}kidos ask${N} ["task"]            ask your OS to do something (AI, you approve each command)
  ${B}kidos update${N} [--check]        update KidOS + all packages, as one undoable snapshot

REF = snapshot number | HEAD | HEAD~N | tag name | current
Temporary checkout: pick "KidOS snapshots" in the boot menu (read-only boot).
EOF
}

# ------------------------------------------------------------ helpers
list() { snap --jsonout list | jq --arg c "$CFG" '.[$c]'; }

resolve() {
  local ref=${1:-HEAD} n k
  case $ref in
    HEAD|head|last)  n=$(list | jq -r '[.[]|select(.number>0)] | last | .number // empty') ;;
    HEAD~*|head~*)   k=${ref#*~}; [[ $k =~ ^[0-9]+$ ]] || die "bad ref: $ref"
                     n=$(list | jq -r --argjson k "$k" \
                       '[.[]|select(.number>0)] | if $k < length then .[length-1-$k].number else empty end') ;;
    current|0)       n=0 ;;
    *[!0-9]*)        n=$(list | jq -r --arg t "$ref" '[.[]|select(.userdata.tag? == $t)] | last | .number // empty') ;;
    *)               n=$(list | jq -r --argjson x "$ref" '.[]|select(.number==$x)|.number') ;;
  esac
  [[ -n $n ]] || die "unknown ref: $ref"
  echo "$n"
}

root_of() { [[ $1 == 0 ]] && echo "" || echo "$SNAPDIR/$1/snapshot"; }

pkgs_at() { pacman -Q --dbpath "$(root_of "$1")/var/lib/pacman" 2>/dev/null | LC_ALL=C sort; }

pkg_diff() { # A B -> lines "+ name ver" / "- name ver" / "~ name old -> new"
  LC_ALL=C join -a1 -a2 -e '-' -o 0,1.2,2.2 <(pkgs_at "$1") <(pkgs_at "$2") |
    awk '$2!=$3 { if ($2=="-") print "+ "$1" "$3; else if ($3=="-") print "- "$1" "$2; else print "~ "$1" "$2" -> "$3 }'
}

paint() { # colorize +/-/~ and snapper status lines
  while IFS= read -r l; do
    case ${l:0:1} in
      +) printf '%s%s%s\n' "$G" "$l" "$N" ;;
      -) printf '%s%s%s\n' "$R" "$l" "$N" ;;
      *) printf '%s%s%s\n' "$Y" "$l" "$N" ;;
    esac
  done
}

meta() { list | jq -r --argjson n "$1" '.[]|select(.number==$n)'; }

# ------------------------------------------------------------ commands
cmd_status() {
  local head changes pk
  head=$(resolve HEAD)
  printf 'On snapshot %s%s%s: %s\n' "$C" "$head" "$N" "$(meta "$head" | jq -r .description)"
  pk=$(pkg_diff "$head" 0)
  changes=$(snap status "$head..0" 2>/dev/null | grep -Ev ' /(\.snapshots|var/lib/systemd|var/tmp|root/\.cache)' || true)
  if [[ -z $pk && -z $changes ]]; then echo "Nothing changed. System is clean."; return; fi
  [[ -n $pk ]] && { echo; echo "${B}Packages:${N}"; paint <<<"$pk"; }
  if [[ -n $changes ]]; then
    echo; echo "${B}Files:${N} $(wc -l <<<"$changes") changed"
    head -n 25 <<<"$changes" | paint
    (( $(wc -l <<<"$changes") > 25 )) && echo "${D}... see all: kidos diff${N}"
  fi
  echo; echo "${D}Save this state:  kidos commit -m \"what you did\"${N}"
}

cmd_commit() {
  local msg="" n
  while (($#)); do
    case $1 in
      -m) msg=${2:-}; shift 2 || shift ;;
      *)  msg="$*"; break ;;
    esac
  done
  [[ -n $msg ]] || die 'usage: kidos commit -m "message"'
  n=$(snap create --print-number --cleanup-algorithm number --description "$msg" --userdata "kidos=commit")
  printf '[%s%s%s] %s\n' "$C" "$n" "$N" "$msg"
}

cmd_log() {
  local limit=0 json=0
  while (($#)); do
    case $1 in
      --json) json=1; shift ;;
      -n) limit=${2:?}; shift 2 ;;
      *) die "log: unknown option $1" ;;
    esac
  done
  if ((json)); then list; return; fi
  list | jq -r --argjson lim "$limit" '
      [.[] | select(.number>0)] | reverse | (if $lim>0 then .[:$lim] else . end) | .[] |
      [ (.number|tostring), .date,
        (if .userdata.kidos? == "commit" then "commit" elif .type=="single" then "snapshot" else "auto:"+.type end),
        (.userdata.tag? // ""), .description ] | join("\u001f")' |
  while IFS=$'\x1f' read -r num date kind tag desc; do
    local col=$D; [[ $kind == commit ]] && col=$Y
    printf '%s%5s%s  %s%s%s  %s%-11s%s %s' "$col" "$num" "$N" "$D" "$date" "$N" "$col" "$kind" "$N" "$desc"
    [[ -n $tag ]] && printf '  %s(tag: %s)%s' "$G" "$tag" "$N"
    echo
  done
}

cmd_show() {
  local n m prev
  n=$(resolve "${1:-HEAD}")
  [[ $n != 0 ]] || die "show: pick a snapshot, not 'current'"
  m=$(meta "$n")
  jq -r '"snapshot \(.number)\nDate:   \(.date)\nType:   \(.type)\nUser:   \(.user)\n\n    \(.description)\n"' <<<"$m"
  # compare with the pre-snapshot for pacman pairs, else the previous snapshot
  prev=$(jq -r '."pre-number" // empty' <<<"$m")
  [[ -z $prev ]] && prev=$(list | jq -r --argjson n "$n" '[.[]|select(.number>0 and .number<$n)] | last | .number // empty')
  if [[ -n $prev ]]; then
    local d; d=$(pkg_diff "$prev" "$n")
    echo "${B}Packages vs $prev:${N}"; if [[ -n $d ]]; then paint <<<"$d"; else echo "  (none)"; fi
  fi
}

cmd_diff() {
  local pkgs=0 args=() a b d
  for x in "$@"; do if [[ $x == --pkgs ]]; then pkgs=1; else args+=("$x"); fi; done
  a=$(resolve "${args[0]:-HEAD}"); b=$(resolve "${args[1]:-current}")
  echo "${B}diff $a..$b${N}"
  d=$(pkg_diff "$a" "$b")
  echo "${B}Packages:${N}"; if [[ -n $d ]]; then paint <<<"$d"; else echo "  (none)"; fi
  ((pkgs)) && return
  echo "${B}Files:${N}"
  snap status "$a..$b" | paint
}

cmd_tag() {
  local n; n=$(resolve "${1:?usage: kidos tag REF NAME}")
  [[ ${2:-} =~ ^[A-Za-z][A-Za-z0-9._-]*$ ]] || die "tag name must start with a letter (letters, digits, . _ -)"
  snap modify --userdata "tag=$2,important=yes" "$n"
  echo "tagged $n as $2"
}

cmd_restore() {
  local n; n=$(resolve "${1:?usage: kidos restore REF PATH...}"); shift
  (($#)) || die "usage: kidos restore REF PATH..."
  local p abs=()
  for p in "$@"; do abs+=("$(realpath -m "$p")"); done
  echo "Restore to their state at snapshot $n:"; printf '  %s\n' "${abs[@]}"
  confirm "Continue?"
  snap undochange "$n..0" "${abs[@]}"
}

top_mount() { # mount the btrfs top level (subvolid=5), print mountpoint
  local dev t
  dev=$(findmnt -no SOURCE / | sed 's/\[.*\]$//')
  t=$(mktemp -d /run/kidos-top.XXXX)
  mount -o subvolid=5 "$dev" "$t"
  echo "$t"
}

cmd_rollback() {
  local n safety t stamp
  n=$(resolve "${1:?usage: kidos rollback REF}")
  [[ $n != 0 ]] || die "rollback: pick a snapshot"
  [[ $(findmnt -no FSROOT /) == /@ ]] || die "root is not @ (booted into a snapshot?). Boot normally, then run: kidos rollback $n"
  echo "Snapshot $n: $(meta "$n" | jq -r .description)"
  confirm "Replace the running OS with snapshot $n? (/home is not touched)"
  safety=$(snap create --print-number --cleanup-algorithm number \
    --description "before rollback to $n" --userdata "kidos=commit,important=yes")
  t=$(top_mount)
  trap 'umount "$t" 2>/dev/null; rmdir "$t" 2>/dev/null' EXIT
  stamp=$(date +%Y%m%d-%H%M%S)
  btrfs subvolume snapshot "$t/@snapshots/$n/snapshot" "$t/@new" >/dev/null
  mv "$t/@" "$t/@old-$stamp"
  mv "$t/@new" "$t/@"
  echo "${G}Done.${N} Reboot to run snapshot $n."
  echo "Undo: kidos rollback $safety   (old root kept as @old-$stamp until 'kidos gc')"
}

cmd_hook() { # called by /etc/pacman.d/hooks/*kidos*.hook — never let a snapshot failure break pacman
  local phase=${1:-} state=/run/kidos-pacman-pre desc targets n
  mapfile -t targets || true
  [[ -n ${KIDOS_NO_HOOK:-} ]] && return 0   # kidos update takes its own snapshot pair
  desc=$(tr '\0' ' ' < "/proc/$PPID/cmdline" 2>/dev/null || true)
  [[ $desc == *pacman* ]] || desc="pacman ${targets[*]}"
  desc=${desc% }; ((${#desc} > 80)) && desc="${desc:0:77}..."
  case $phase in
    pre)
      n=$(snap create --type pre --print-number --cleanup-algorithm number \
            --description "$desc" 2>/dev/null) && echo "$n" > "$state" \
        || echo "kidos: warning: pre-snapshot failed" >&2 ;;
    post)
      if [[ -s $state ]]; then
        local pre; pre=$(<"$state")
        n=$(snap create --type post --pre-number "$pre" --print-number \
              --cleanup-algorithm number --description "$desc" 2>/dev/null) || n=""
        rm -f "$state"
        [[ -n $n ]] && echo "kidos: saved snapshots — undo with: kidos rollback $pre" \
          || echo "kidos: warning: post-snapshot failed" >&2
      fi
      # a 'filesystem' package upgrade resets /etc/os-release to Arch's; put KidOS back
      [[ -L /etc/os-release ]] && cmd_brand --no-grub >/dev/null 2>&1 ;;
  esac
  return 0
}

cmd_gc() {
  local t olds
  snap cleanup number
  t=$(top_mount)
  trap 'umount "$t" 2>/dev/null; rmdir "$t" 2>/dev/null' EXIT
  mapfile -t olds < <(find "$t" -maxdepth 1 -name '@old-*' -printf '%f\n' | sort)
  if ((${#olds[@]})); then
    printf 'Leftover roots from rollbacks:\n'; printf '  %s\n' "${olds[@]}"
    confirm "Delete them?"
    for o in "${olds[@]}"; do btrfs subvolume delete "$t/$o" >/dev/null; echo "deleted $o"; done
  fi
  echo "gc done."
}

cmd_snap() { # internal, used by kidos-ask: _snap pre DESC | _snap post PRE DESC
  case ${1:-} in
    pre)  snap create --type pre --print-number --cleanup-algorithm number --description "${2:-kidos}" ;;
    post) snap create --type post --pre-number "${2:?}" --print-number --cleanup-algorithm number --description "${3:-kidos}" ;;
    *) die "_snap pre|post" ;;
  esac
}

cmd_brand() { # (re)apply KidOS identity: os-release, console banner, GRUB colours
  local nogrub=0 changed=0
  [[ ${1:-} == --no-grub ]] && nogrub=1
  if ! cmp -s /usr/share/kidos/os-release /etc/os-release 2>/dev/null || [[ -L /etc/os-release ]]; then
    rm -f /etc/os-release; cp /usr/share/kidos/os-release /etc/os-release
  fi
  cmp -s /usr/share/kidos/issue /etc/issue 2>/dev/null || cp /usr/share/kidos/issue /etc/issue
  if [[ -f /etc/default/grub ]]; then
    local g=/etc/default/grub before; before=$(md5sum < "$g")
    sed -i -e 's/^#\?GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="KidOS"/' \
           -e '/^#\?GRUB_COLOR_NORMAL=/d' -e '/^#\?GRUB_COLOR_HIGHLIGHT=/d' "$g"
    printf 'GRUB_COLOR_NORMAL="light-gray/black"\nGRUB_COLOR_HIGHLIGHT="light-blue/black"\n' >> "$g"
    [[ $(md5sum < "$g") != "$before" ]] && changed=1
    if ((changed && !nogrub)) && [[ -d /boot/grub ]]; then grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1; fi
  fi
  echo "KidOS branding applied."
}

cmd_update() {
  local conf=/etc/kidos/kidos.conf src=/var/lib/kidos/src check=0 system=1 REPO="" old new pre post u home
  while (($#)); do
    case $1 in
      --check) check=1; shift ;;
      --no-system) system=0; shift ;;
      --repo) mkdir -p /etc/kidos; printf 'REPO=%q\n' "${2:?--repo URL}" > "$conf"; shift 2 ;;
      *) die "update: unknown option $1 (use --check, --repo URL, --no-system)" ;;
    esac
  done
  # shellcheck source=/dev/null
  [[ -f $conf ]] && . "$conf"
  [[ -n $REPO ]] || die "no KidOS repo set. Run once:  kidos update --repo https://github.com/<you>/kidos"

  echo "${B}Fetching KidOS from${N} $REPO"
  if [[ -d $src/.git ]]; then
    git -C "$src" remote set-url origin "$REPO"
    git -C "$src" fetch -q --depth 50 origin || die "fetch failed"
    git -C "$src" reset -q --hard FETCH_HEAD
  else
    rm -rf "$src"; mkdir -p "$(dirname "$src")"
    git clone -q --depth 50 "$REPO" "$src" || die "clone failed"
  fi
  old=$(cat /etc/kidos/version 2>/dev/null || true)
  new=$(git -C "$src" rev-parse HEAD)
  if [[ $old == "$new" ]]; then
    echo "KidOS is up to date (${new:0:7})."
  else
    echo "${B}KidOS changes:${N}"
    if [[ -n $old ]] && git -C "$src" cat-file -e "$old" 2>/dev/null; then
      git -C "$src" log --oneline "$old..$new" | sed 's/^/  /'
    else
      git -C "$src" log --oneline -5 | sed 's/^/  /'
    fi
  fi
  ((check)) && { ((system)) && { echo; echo "${B}Package updates:${N}"; checkupdates 2>/dev/null || pacman -Qu 2>/dev/null || true; }; return; }

  pre=$(snap create --type pre --print-number --cleanup-algorithm number --description "kidos update")
  export KIDOS_NO_HOOK=1

  # 1. KidOS files (--remove-destination: never rewrite a running script in place)
  cp -a --remove-destination --no-preserve=ownership "$src/system/." /
  chmod 755 /usr/local/bin/kidos*
  chmod 440 /etc/sudoers.d/*kidos* 2>/dev/null || true

  # 2. packages: full upgrade + anything new in the KidOS package list
  local pkgs; mapfile -t pkgs < <(grep -Ev '^\s*(#|$)' "$src/packages/base.txt")
  if ((system)); then
    pacman -Syu --needed --noconfirm "${pkgs[@]}"
  else
    pacman -S --needed --noconfirm "${pkgs[@]}"
  fi

  # 3. identity + new default configs for the user (never overwrite theirs)
  cmd_brand
  if [[ -n ${SUDO_USER:-} && $SUDO_USER != root ]]; then
    u=$SUDO_USER; home=$(getent passwd "$u" | cut -d: -f6)
    (cd /etc/skel && find . -type f) | while read -r f; do
      if [[ ! -e $home/$f ]]; then
        install -D -o "$u" -g "$u" -m 644 "/etc/skel/$f" "$home/$f"; echo "  new config: ~/${f#./}"
      fi
    done
  fi

  echo "$new" > /etc/kidos/version
  post=$(snap create --type post --pre-number "$pre" --print-number --cleanup-algorithm number --description "kidos update ${new:0:7}")
  echo
  echo "${G}KidOS updated${N} (${new:0:7}). Snapshots $pre..$post — undo with: kidos rollback $pre"
  echo "Reload the desktop with Super+Shift+R (reboot if the kernel was updated)."
}

# ------------------------------------------------------------ main
cmd=${1:-help}; shift || true
case $cmd in
  help|-h|--help) usage; exit 0 ;;
  version|--version) echo "kidos $VERSION"; exit 0 ;;
  ask) exec kidos-ask "$@" ;;          # runs as the normal user
esac
[[ $EUID -eq 0 ]] || exec sudo -- "$0" "$cmd" "$@"
command -v snapper >/dev/null || die "snapper not installed"
# every branch ends in exit: kidos update replaces this file while it runs
case $cmd in
  status|st)  cmd_status "$@"; exit ;;
  commit|ci)  cmd_commit "$@"; exit ;;
  log)        cmd_log "$@"; exit ;;
  show)       cmd_show "$@"; exit ;;
  diff)       cmd_diff "$@"; exit ;;
  tag)        cmd_tag "$@"; exit ;;
  restore)    cmd_restore "$@"; exit ;;
  rollback)   cmd_rollback "$@"; exit ;;
  gc)         cmd_gc "$@"; exit ;;
  update|up)  cmd_update "$@"; exit ;;
  brand)      cmd_brand "$@"; exit ;;
  _hook)      cmd_hook "$@"; exit ;;
  _snap)      cmd_snap "$@"; exit ;;
  *) usage; die "unknown command: $cmd" ;;
esac
